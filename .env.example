# Copy this file to .env. Never commit the resulting .env file.
AIRFLOW_UID=50000
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=change-me-before-sharing
AIRFLOW_API_SECRET_KEY=change-me-before-sharing
AIRFLOW_JWT_SECRET=change-me-before-sharing
POSTGRES_PASSWORD=change-me-before-sharing

# Pinned runtime versions
AIRFLOW_VERSION=3.1.7
HADOOP_VERSION=3.5.0
SPARK_VERSION=3.5.7
POSTGRES_VERSION=16-alpine

# Pipeline defaults
PIPELINE_LOG_LEVEL=INFO
UCI_SOURCE_URL=https://archive.ics.uci.edu/static/public/235/individual+household+electric+power+consumption.zip
EXPECTED_SOURCE_SHA256=
HDFS_URI=hdfs://namenode:9000
WEBHDFS_URL=http://namenode:9870
MAX_NULL_RATIO=0.05
